# Leave NVIDIA_API_KEY unset to run entirely on the deterministic mock backend.
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

MVB_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
MVB_VLM_MODEL=nvidia/vila
MVB_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
MVB_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Force the mock backend even when a key is present (used by the test suite).
# MVB_FORCE_MOCK=1

# Adapter to serve. "base" serves the un-post-trained checkpoint.
MVB_ADAPTER=lora-v3

# Observability
MVB_TRACE_DIR=runs/traces
MVB_TRACE_ENABLED=1
